# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHÍNH THỨC (PRODUCTION / RENDER)
# ==========================================

# 1. Chế độ hoạt động ('production' khi chạy Webhook trên Render, 'development' khi test polling local)
NODE_ENV=production

# 2. Telegram Bot Token từ @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# 3. Chuỗi kết nối Neon PostgreSQL
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# 4. Cổng khởi chạy server (Render tự cấp cổng ngẫu nhiên qua PORT, local mặc định 3000)
PORT=3000

# 5. URL dịch vụ Render của bot (Dùng để kích hoạt Webhook Telegram tự động)
RENDER_EXTERNAL_URL=https://chatboxai-eoul.onrender.com

# 6. Thông tin tài khoản ngân hàng nhận tiền chuyển khoản (VietQR)
BANK_ACCOUNT_NO=0550767799967
BANK_BIN=970422
BANK_NAME=MB Bank

# 7. ID Telegram của Quản trị viên (Admin) duy nhất
ADMIN_TELEGRAM_IDS=5638827352

# 8. Username Telegram hỗ trợ khách hàng
SUPPORT_USERNAME=@ea7bpp

# 9. Giá mua gói VIP vĩnh viễn (VNĐ)
VIP_PRICE=139000

# 10. Khóa bí mật API Key của SePay Webhook (tùy chọn bảo mật)
SEPAY_API_KEY=

# 11. Đường dẫn hướng dẫn đọc truyện
GUIDE_LINK=https://docs.google.com/document/d/1HYw_H1AzUoQwZudRZg3da4VlzMK7PEf-ey5jD2syMCY/edit?usp=sharing
